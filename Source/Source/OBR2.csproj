<Project Sdk="Microsoft.NET.Sdk">
	<PropertyGroup>
		<OutputType>Library</OutputType>
		<TargetFramework>net10.0</TargetFramework>
		<PlatformTarget>x64</PlatformTarget>

		<!-- Modify [RootNamespace], [AssemblyName], [OutputPath], [VersionPrefix] -->
		<RootNamespace>OBR2</RootNamespace>
		<AssemblyName>OBR2</AssemblyName>
		<OutputPath>../../1.7/Assemblies</OutputPath>
		<VersionPrefix>1.0.0.0</VersionPrefix>

		<!-- do not generate pdb file -->
		<DebugType>none</DebugType>

		<DebugSymbols>false</DebugSymbols>
		<AppendTargetFrameworkToOutputPath>false</AppendTargetFrameworkToOutputPath>
		<LangVersion>Latest</LangVersion>
	</PropertyGroup>

 	<ItemGroup>
	 	<!-- Mod -->
	 	<Compile  Include="..\**\*.cs" Exclude="..\**\obj\**\*" />
		
	 	<!-- Rimworld -->
	 	<Reference Include="../../../../*.dll" Condition="Exists('../../../../')">
			<Private>False</Private>
		</Reference>

		<!-- Harmony -->
		<Reference Include="..\..\..\..\..\..\workshop\content\294100\2009463077\1.7\Assemblies\*.dll">
			<Private>False</Private>
		</Reference>

		<!-- Other Files -->
		<None Include="../../../../Mods/**"/>
		<None Include="../../../../Data/**"/>
		<None Include="../../1.7/Defs/**" LinkBase="Defs" />
		<None Include="../../1.7/Assemblies/**" LinkBase="Assemblies" />
		<None Include="../../Textures/**" LinkBase="Textures" />
	</ItemGroup>
</Project>
